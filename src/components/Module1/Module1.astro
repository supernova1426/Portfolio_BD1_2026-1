      "Sistema organizacional y administrativo de una compañía multinacional.",

    topic:
      "MER • MER-E • Crow's Foot",

    exerciseStatement:
      `BLOQUE 3: LA COMPAÑÍA (COMPANY)

Sistema para gestionar empleados, departamentos, proyectos y dependientes.`,

    objective:
      "Diseñar un sistema organizacional completo basado en estructuras jerárquicas empresariales.",

    learned:
      `• Relaciones recursivas.\n
• Entidades débiles.\n
• Jerarquías organizacionales.\n
• Gestión de proyectos.\n
• Conversión a Crow's Foot.`,

    process:
      `1. Interpretación del caso.\n
2. Diseño del MER.\n
3. Extensión a MER-E.\n
4. Conversión a Crow's Foot.\n
5. Validación del modelo.`,

    tools:
      `• draw.io\n
• DataModeler\n`,

    result:
      "Se logró representar correctamente la estructura organizacional y operativa de la empresa.",

    reflection:
      "El ejercicio fortaleció la comprensión de dependencias, jerarquías y entidades débiles.",

    diagrams: [
      {
        label: "Modelo MER",
        url: "https://drive.google.com/file/d/1rXd3Jt5RxFl00jTsUilPhmqpUUXxksh2/view?usp=sharing"
      },
      {
        label: "Modelo MER-E",
        url: "https://drive.google.com/file/d/1rXd3Jt5RxFl00jTsUilPhmqpUUXxksh2/view?usp=sharing"
      },
      {
        label: "Modelo Crow's Foot zip",
        url: "/Portfolio_BD1_2026-1/documents/modone/tCompany.zip"
      }
    ],

    image: "/Portfolio_BD1_2026-1/images/modone/tCompany.png",
  },

];
---

<Section id="modulos" title="Módulo 1 - MER">

  <!-- GRID -->
  <div class="grid grid-cols-1 gap-10 md:grid-cols-2">

    {
      MODUNO.map((moduno) => (
        <article
          class="cursor-pointer overflow-hidden rounded-3xl border border-white/10 bg-gray-900/40 shadow-xl transition hover:scale-[1.02]"
          onclick={`openModal(${JSON.stringify(moduno)})`}
        >

          <!-- Imagen -->
          <img
            src={moduno.image}
            alt={moduno.name}
            class="w-full"
          />

          <!-- Contenido -->
          <div class="space-y-4 p-6">

            <h2 class="text-2xl font-bold text-white">
              {moduno.name}
            </h2>

            <p class="text-sm font-medium text-cyan-400">
              {moduno.topic}
            </p>

            <p class="text-gray-300">
              {moduno.shortDescription}
            </p>

          </div>

        </article>
      ))
    }

  </div>

</Section>

<!-- TALLER ENTREGADO -->
<Section
  id="taller-entregado"
  title="Taller Entregado"
>

  <div class="mt-10 space-y-8">

    {
      TALLER_ENTREGADO.map((taller) => (

        <article
          class="flex flex-col overflow-hidden rounded-3xl border border-white/10 bg-gray-900/40 shadow-xl transition hover:scale-[1.01] md:flex-row"
          onclick={`openModal(${JSON.stringify(taller)})`}
        >

          <!-- Imagen -->
          <img
            src={taller.image}
            alt={taller.name}
            class="h-full w-full object-cover md:w-[350px]"
          />

          <!-- Contenido -->
          <div class="flex flex-1 flex-col justify-center p-8">

            <h2 class="mb-3 text-3xl font-bold text-white">
              {taller.name}
            </h2>

            <p class="mb-4 text-cyan-400">
              {taller.topic}
            </p>

            <p class="text-gray-300">
              {taller.shortDescription}
            </p>

          </div>

        </article>

      ))
    }

  </div>

</Section>

<!-- MODAL -->
<div
  id="modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 p-4"
  onclick="closeModal()"
>

  <div
    class="max-h-[90vh] w-full max-w-5xl overflow-y-auto rounded-2xl bg-gray-900 p-6 text-white shadow-2xl scrollbar-thin scrollbar-thumb-gray-700 scrollbar-track-gray-900"
    onclick="event.stopPropagation()"
  >

    <!-- Imagen -->
    <img
      id="modal-img"
      class="mb-6 w-full rounded-2xl"
    />

    <!-- Título -->
    <h2
      id="modal-title"
      class="mb-2 text-3xl font-bold"
    ></h2>

    <!-- Descripción corta -->
    <p
      id="modal-short"
      class="mb-6 text-gray-300"
    ></p>

    <!-- CONTENIDO -->
    <div class="space-y-6">

      <!-- Tema -->
      <div>
        <h3 class="mb-2 text-lg font-semibold text-cyan-400">
          Tema trabajado
        </h3>

        <p
          id="modal-topic"
          class="text-gray-300"
        ></p>
      </div>

      <!-- Enunciado -->
      <div>
        <h3 class="mb-2 text-lg font-semibold text-cyan-400">
          Enunciado del ejercicio
        </h3>

        <p
          id="modal-statement"
          class="text-gray-300"
        ></p>
      </div>

      <!-- Objetivo -->
      <div>
        <h3 class="mb-2 text-lg font-semibold text-cyan-400">
          Objetivo
        </h3>

        <p
          id="modal-objective"
          class="text-gray-300"
        ></p>
      </div>

      <!-- Aprendizaje -->
      <div>
        <h3 class="mb-2 text-lg font-semibold text-cyan-400">
          Conceptos aprendidos
        </h3>

        <pre
          id="modal-learned"
          class="whitespace-pre-wrap font-sans text-gray-300"
        ></pre>
      </div>

      <!-- Proceso -->
      <div>
        <h3 class="mb-2 text-lg font-semibold text-cyan-400">
          Proceso realizado
        </h3>

        <pre
          id="modal-process"
          class="whitespace-pre-wrap font-sans text-gray-300"
        ></pre>
      </div>

      <!-- Herramientas -->
      <div>
        <h3 class="mb-2 text-lg font-semibold text-cyan-400">
          Herramientas utilizadas
        </h3>

        <pre
          id="modal-tools"
          class="whitespace-pre-wrap font-sans text-gray-300"
        ></pre>
      </div>

      <!-- Resultado -->
      <div>
        <h3 class="mb-2 text-lg font-semibold text-cyan-400">
          Resultado obtenido
        </h3>

        <p
          id="modal-result"
          class="text-gray-300"
        ></p>
      </div>

      <!-- Reflexión -->
      <div>
        <h3 class="mb-2 text-lg font-semibold text-cyan-400">
          Reflexión
        </h3>

        <p
          id="modal-reflection"
          class="text-gray-300"
        ></p>
      </div>

      <!-- Links -->
      <div
        id="modal-links"
        class="space-y-2"
      ></div>

    </div>

    <!-- Botón -->
    <button
      class="mt-8 rounded-xl bg-white px-5 py-2 font-medium text-black transition hover:bg-gray-200"
      onclick="closeModal()"
    >
      Cerrar
    </button>

  </div>

</div>

<!-- SCRIPT -->
<script is:inline>

  function openModal(item) {

    // Título
    document.getElementById("modal-title").innerText =
      item.name || "";

    // Imagen
    document.getElementById("modal-img").src =
      item.image || "";

    // Descripción
    document.getElementById("modal-short").innerText =
      item.shortDescription || "";

    // Tema
    document.getElementById("modal-topic").innerText =
      item.topic || "";

    // Enunciado
    document.getElementById("modal-statement").innerText =
      item.exerciseStatement || "";

    // Objetivo
    document.getElementById("modal-objective").innerText =
      item.objective || "";

    // Aprendizaje
    document.getElementById("modal-learned").innerText =
      item.learned || "";

    // Proceso
    document.getElementById("modal-process").innerText =
      item.process || "";

    // Herramientas
    document.getElementById("modal-tools").innerText =
      item.tools || "";

    // Resultado
    document.getElementById("modal-result").innerText =
      item.result || "";

    // Reflexión
    document.getElementById("modal-reflection").innerText =
      item.reflection || "";

// LINKS O DIAGRAMAS
const linksContainer =
  document.getElementById("modal-links");

linksContainer.innerHTML = "";

// Detecta si el objeto usa links o diagrams
const resources =
  item.links || item.diagrams || [];

if (resources.length) {

  linksContainer.innerHTML += `
    <h3 class="text-lg font-semibold text-cyan-400">
      Recursos y diagramas
    </h3>
  `;

  resources.forEach(link => {

    linksContainer.innerHTML += `
      <a
    href="${link.url}"
    download
    class="block text-blue-400 underline transition hover:text-blue-300"
  >
        ${link.label}
      </a>
    `;

  });
}

    // MOSTRAR MODAL CENTRADO
    const modal = document.getElementById("modal");

    modal.classList.remove("hidden");
    modal.classList.add("flex");
  }

  function closeModal() {

    // OCULTAR MODAL
    const modal = document.getElementById("modal");

    modal.classList.remove("flex");
    modal.classList.add("hidden");
  }

</script>