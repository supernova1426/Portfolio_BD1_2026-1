---
import Section from "../UI/Section.astro";

const MODUNO = [
  {
    name: "Ejercicio 1 en Clase_AEREOLINEA",

    shortDescription:
      "El propósito de esta práctica fue diseñar el Modelo Entidad-Relación (MER) para controlar las operaciones diarias de una aerolínea.",

    image: "/Portfolio_BD1_2026-1/images/modone/aereolinea.png",
  },

  {
    name: "Modelo Aerolínea",

    shortDescription:
      "Modelo relacional para operaciones aéreas.",

    image: "/Portfolio_BD1_2026-1/images/modone/aereolinea.png",
  },
];
---

<Section id="modulos" title="Módulo 1">

  <div class="grid grid-cols-1 gap-10 md:grid-cols-2">

    {
      MODUNO.map((moduno) => (
        <article
          class="overflow-hidden rounded-3xl border border-white/10 bg-gray-900/40 shadow-xl"
        >

          <img
            src={moduno.image}
            alt={moduno.name}
            class="w-full"
          />

          <div class="p-6 space-y-4">

            <h2 class="text-2xl font-bold text-white">
              {moduno.name}
            </h2>

            <p class="text-gray-300">
              {moduno.shortDescription}
            </p>

          </div>

        </article>
      ))
    }

  </div>

</Section>