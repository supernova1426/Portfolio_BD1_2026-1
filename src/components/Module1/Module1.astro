---
import Section from "../UI/Section.astro";

const MODUNO = [
  {
    name: "Ejercicio 1 en Clase_AEREOLINEA",

    shortDescription:
      "Ejercicio enfocado en el diseño de un Modelo Entidad-Relación (MER) para representar la operación básica de una aerolínea y fortalecer el análisis de entidades, relaciones y cardinalidades.",

    topic:
      "Modelo Entidad-Relación (MER)",

    objective:
      "Aplicar los conceptos fundamentales del modelado conceptual mediante el desarrollo de un MER capaz de representar la gestión de vuelos, aviones, pilotos, tripulación y bases operativas.",

    learned:
      `• Identificación de entidades principales y atributos.\n
• Uso de llaves primarias para representar entidades únicas.\n
• Aplicación de relaciones 1:N y N:M.\n
• Manejo de atributos compuestos y multivalorados.\n
• Organización correcta de procesos operativos dentro de entidades independientes para evitar redundancia.\n
• Interpretación de reglas de negocio a partir de un caso real.`,

    process:
      `1. Se analizó el problema planteado para identificar las entidades principales del sistema.\n
2. Se definieron atributos y llaves primarias para cada entidad.\n
3. Se establecieron las relaciones entre aviones, vuelos, pilotos, tripulación y bases.\n
4. Se determinaron las cardinalidades según las reglas del negocio.\n
5. Finalmente, el modelo fue digitalizado y organizado utilizando draw.io.`,

    tools:
      `• draw.io\n
• app.diagrams.net`,

    result:
      "Se obtuvo un modelo MER organizado y coherente que representa adecuadamente la operación logística de una aerolínea, permitiendo visualizar claramente las relaciones entre recursos físicos, personal y vuelos.",

    reflection:
      "Este ejercicio permitió fortalecer la comprensión de las cardinalidades y la importancia de separar correctamente las entidades operativas para evitar redundancia en el diseño conceptual.",

    links: [
      {
        label: "Diagrama MER",
        url: "https://drive.google.com/file/d/1DgBU0lWG01YNXXNIAARiruJyB5dDWwut/view?usp=sharing",
      },
    ],

    image: "/Portfolio_BD1_2026-1/images/modone/aereolinea.png",
  },
];
---

<Section id="modulos" title="Módulo 1 - MER">

  <!-- GRID -->
  <div class="grid grid-cols-1 gap-10 md:grid-cols-2">

    {
      MODUNO.map((moduno) => (
        <article
          class="cursor-pointer overflow-hidden rounded-3xl border border-white/10 bg-gray-900/40 shadow-xl transition hover:scale-[1.02]"
          onclick={`openModal(${JSON.stringify(moduno)})`}
        >

          <img
            src={moduno.image}
            alt={moduno.name}
            class="w-full"
          />

          <div class="space-y-4 p-6">

            <h2 class="text-2xl font-bold text-white">
              {moduno.name}
            </h2>

            <p class="text-sm text-cyan-400">
              {moduno.topic}
            </p>

            <p class="text-gray-300">
              {moduno.shortDescription}
            </p>

          </div>

        </article>
      ))
    }

  </div>

</Section>

<!-- MODAL -->
<div
  id="modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 p-4"
  onclick="closeModal()"
>

  <div
    class="max-h-[90vh] w-full max-w-5xl overflow-y-auto rounded-2xl bg-gray-900 p-6 text-white shadow-2xl scrollbar-thin scrollbar-thumb-gray-700 scrollbar-track-gray-900"
    onclick="event.stopPropagation()"
  >

    <!-- Imagen -->
    <img
      id="modal-img"
      class="mb-6 w-full rounded-2xl"
    />

    <!-- Título -->
    <h2
      id="modal-title"
      class="mb-2 text-3xl font-bold"
    ></h2>

    <!-- Descripción corta -->
    <p
      id="modal-short"
      class="mb-6 text-gray-300"
    ></p>

    <!-- CONTENIDO -->
    <div class="space-y-6">

      <div>
        <h3 class="mb-2 text-lg font-semibold text-cyan-400">
          Tema trabajado
        </h3>

        <p
          id="modal-topic"
          class="text-gray-300"
        ></p>
      </div>

      <div>
        <h3 class="mb-2 text-lg font-semibold text-cyan-400">
          Objetivo
        </h3>

        <p
          id="modal-objective"
          class="text-gray-300"
        ></p>
      </div>

      <div>
        <h3 class="mb-2 text-lg font-semibold text-cyan-400">
          Conceptos aprendidos
        </h3>

        <pre
          id="modal-learned"
          class="whitespace-pre-wrap font-sans text-gray-300"
        ></pre>
      </div>

      <div>
        <h3 class="mb-2 text-lg font-semibold text-cyan-400">
          Proceso realizado
        </h3>

        <pre
          id="modal-process"
          class="whitespace-pre-wrap font-sans text-gray-300"
        ></pre>
      </div>

      <div>
        <h3 class="mb-2 text-lg font-semibold text-cyan-400">
          Herramientas utilizadas
        </h3>

        <pre
          id="modal-tools"
          class="whitespace-pre-wrap font-sans text-gray-300"
        ></pre>
      </div>

      <div>
        <h3 class="mb-2 text-lg font-semibold text-cyan-400">
          Resultado obtenido
        </h3>

        <p
          id="modal-result"
          class="text-gray-300"
        ></p>
      </div>

      <div>
        <h3 class="mb-2 text-lg font-semibold text-cyan-400">
          Reflexión
        </h3>

        <p
          id="modal-reflection"
          class="text-gray-300"
        ></p>
      </div>

      <!-- LINKS -->
      <div
        id="modal-links"
        class="space-y-2"
      ></div>

    </div>

    <!-- BOTÓN -->
    <button
      class="mt-8 rounded-xl bg-white px-5 py-2 font-medium text-black transition hover:bg-gray-200"
      onclick="closeModal()"
    >
      Cerrar
    </button>

  </div>
</div>

<!-- SCRIPT -->
<script is:inline>

  function openModal(item) {

    document.getElementById("modal-title").innerText =
      item.name || "";

    document.getElementById("modal-short").innerText =
      item.shortDescription || "";

    document.getElementById("modal-img").src =
      item.image || "";

    document.getElementById("modal-topic").innerText =
      item.topic || "";

    document.getElementById("modal-objective").innerText =
      item.objective || "";

    document.getElementById("modal-learned").innerText =
      item.learned || "";

    document.getElementById("modal-process").innerText =
      item.process || "";

    document.getElementById("modal-tools").innerText =
      item.tools || "";

    document.getElementById("modal-result").innerText =
      item.result || "";

    document.getElementById("modal-reflection").innerText =
      item.reflection || "";

    // LINKS
    const linksContainer =
      document.getElementById("modal-links");

    linksContainer.innerHTML = "";

    if (item.links?.length) {

      linksContainer.innerHTML += `
        <h3 class="text-lg font-semibold text-cyan-400">
          Recursos
        </h3>
      `;

      item.links.forEach(link => {

        linksContainer.innerHTML += `
          <a
            href="${link.url}"
            target="_blank"
            class="block text-blue-400 underline hover:text-blue-300"
          >
            ${link.label}
          </a>
        `;

      });
    }

    document
      .getElementById("modal")
      .classList.remove("hidden");
  }

  function closeModal() {

    document
      .getElementById("modal")
      .classList.add("hidden");
  }

</script>