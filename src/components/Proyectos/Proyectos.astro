---
import { Icon } from "astro-icon/components";

const proyecto = {
    nombre: "DDeLi",
    descripcion:
        "Es una plataforma digital colombiana de venta de postres artesanales que permite a sus clientes comprar, personalizar y recibir postres a domicilio, todo desde un entorno en línea. No es solo una tienda: combina catálogo, personalización, eventos, suscripciones y promociones en un solo sistema.",
    imagen: "/Portfolio_BD1_2026-1/images/proyectos/DDeLiLogo.png",
    github: "https://github.com/Deivid012-12/DDeLi",
};
---

<section class="relative z-20 px-6 py-20">
    <div class="max-w-5xl mx-auto">
        <!-- Título -->
        <div class="text-center mb-12">
            <h2 class="text-4xl md:text-5xl font-extrabold text-white mb-4">
                Proyectos Realizados
            </h2>

            <p class="text-gray-400">
                Proyecto desarrollado durante el semestre 4.
            </p>
        </div>

        <!-- Card Proyecto -->
        <div
            class="bg-gray-900/40 backdrop-blur-xl border border-white/10 rounded-3xl overflow-hidden shadow-2xl"
        >
            <!-- Imagen -->
            <div class="w-full h-[260px] overflow-hidden">
                <img
                    src={proyecto.imagen}
                    alt={proyecto.nombre}
                    class="w-full h-full object-cover"
                />
            </div>

            <!-- Contenido -->
            <div class="p-8">
                <div
                    class="flex flex-col md:flex-row md:items-center md:justify-between gap-6"
                >
                    <div>
                        <h3 class="text-3xl font-bold text-white mb-4">
                            {proyecto.nombre}
                        </h3>

                        <p class="text-gray-400 leading-relaxed max-w-2xl">
                            {proyecto.descripcion}
                        </p>
                    </div>

                    <!-- Botón GitHub -->
                    <a
                        href={proyecto.github}
                        target="_blank"
                        class="flex items-center justify-center gap-3 bg-primary hover:bg-primary/80 transition-all duration-300 text-white font-semibold px-6 py-4 rounded-2xl min-w-[220px]"
                    >
                     <Icon
                        name="lucide:github"
                        class="size-6"
                    />

                        Ver Repositorio
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .bg-primary {
        background-color: #1c0deb;
    }
</style>